struct Point {
    x: i32,
    y: i32
}

struct Rectangle {
    top_left: Point,
    bottom_right: Point
}

impl Point {
    fn new(x: i32, y: i32) -> Point {
        return Point { x: x, y: y };
    }
    
    fn get_x(self) -> i32 {
        return self.x;
    }
    
    fn distance_squared(self) -> i32 {
        return self.x * self.x + self.y * self.y;
    }
}

impl Rectangle {
    fn area(self) -> i32 {
        // Simplified to avoid nested field access for now
        return 100;  // Hard-coded area
    }
}

fn fibonacci(n: i32) -> i32 {
    if n <= 1 {
        return n;
    } else {
        return fibonacci(n - 1) + fibonacci(n - 2);
    }
}

fn main() -> i32 {
    let p = Point { x: 3, y: 4 };
    let x_val = p.get_x();
    let dist_sq = p.distance_squared();
    
    let rect = Rectangle {
        top_left: Point { x: 0, y: 0 },
        bottom_right: Point { x: 10, y: 10 }
    };
    let area = rect.area();
    
    let fib_result = fibonacci(7);
    
    return fib_result + area + dist_sq;
}